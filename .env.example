# Configuration for a deployed instance. Copy to .env and fill in.
# .env is gitignored — never commit real values.
#
# The values below are shaped for the Azure deployment in infra/, which is the only
# deployment this repository describes. Placeholders are written as <angle brackets> and
# every one of them has to be replaced; the service will not start on a placeholder.
#
# Running locally instead? You do not need most of this. `make up` starts Postgres, MinIO
# and the model servers on their default ports, and application-local.yml already points
# at them, so a local checkout needs ANTHROPIC_API_KEY and nothing else. See README.md.

# ---------------------------------------------------------------- database
# Azure Database for PostgreSQL Flexible Server. sslmode=require is not optional: the
# server refuses unencrypted connections, and the driver will not negotiate TLS without it.
POSTGRES_URL=jdbc:postgresql://<server-name>.postgres.database.azure.com:5432/rover?sslmode=require
POSTGRES_USER=rover
POSTGRES_PASSWORD=<database-password>

# ---------------------------------------------------------------- identity
# This service issues the JWTs it validates. See docs/ARCHITECTURE.md.
#
# The issuer is the address a browser reaches, which is the frontend's — it holds the only
# public ingress and proxies /oauth2, /login and /.well-known through to this service. An
# issuer naming this service's own internal address would put a hostname in every token
# that no client can resolve, and the failure surfaces at the client rather than here.
ROVER_ISSUER_URI=https://<app-name>.<region>.azurecontainerapps.io

# Where the interface is sent back to after signing in. Comma-separated if more than one.
ROVER_WEB_REDIRECT_URIS=https://<app-name>.<region>.azurecontainerapps.io/auth/callback

# Where a verification or reset link lands. The interface, not this service: the endpoints
# behind those links take a JSON body over POST, so a browser following one arrives with a
# GET and is refused. The pages at /account/verify and /account/reset submit the token.
ROVER_INTERFACE_URL=https://<app-name>.<region>.azurecontainerapps.io

# Protects the private half of each signing key at rest. 32 bytes, base64. The service
# refuses to start without one rather than failing at the first sign-in.
#     openssl rand -base64 32
ROVER_KEY_ENCRYPTION_KEY=<openssl rand -base64 32>

# ---------------------------------------------------------------- mail
# Verification and password reset need somewhere to send. Outside the local profile the
# service does not start without a host: a deployment that cannot deliver a reset link
# should say so on boot rather than at the first person who needs one.
#
# Any SMTP relay works. With SendGrid the username is the literal word `apikey` and the
# password is the key itself; with Azure Communication Services it is the connection
# string's credential. Port 587 with STARTTLS is the configured default.
SPRING_MAIL_HOST=<smtp-host>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp-username>
SPRING_MAIL_PASSWORD=<smtp-password>
ROVER_MAIL_FROM=no-reply@<your-domain>

# ---------------------------------------------------------------- model provider
# Answer generation. Model IDs are rows in the `models` table rather than constants —
# see the seed data in the baseline migration.
ANTHROPIC_API_KEY=<sk-ant-...>

# ---------------------------------------------------------------- object storage
# Uploaded originals. `azure-blob` selects the Azure client; `s3` selects the S3 client,
# which is what MinIO uses locally. The two share a key format, so a document is addressed
# the same way under either.
ROVER_STORAGE_PROVIDER=azure-blob
ROVER_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
ROVER_STORAGE_BUCKET=rover-documents

# Left empty on purpose. With no connection string the account URL is used with
# DefaultAzureCredential, which resolves the container app's managed identity at runtime —
# so no storage key is issued, configured, rotated or leaked. Set this only for a local run
# against Azurite.
ROVER_STORAGE_CONNECTION_STRING=

# Storage is optional. With it off there is no client at all: uploads still work and the
# extracted text is still indexed, but the original file is not kept.
ROVER_STORAGE_ENABLED=true

# ---------------------------------------------------------------- internal services
# The Python service, addressed by name inside the container app environment. It serves
# embeddings, reranking and document parsing from one process, which is why these three
# point at the same place.
EMBEDDINGS_URL=http://<name-prefix>-ml
RERANKER_URL=http://<name-prefix>-ml
ROVER_PARSING_URL=http://<name-prefix>-ml
LATE_INTERACTION_URL=http://<name-prefix>-ml

# ---------------------------------------------------------------- optional
# Which reranker a request gets when it asks for one. Reranking is off by default either
# way: both models are far outside the 150 ms retrieval budget. See docs/RESULTS.md.
#   late-interaction | cross-encoder
RERANK_STRATEGY=late-interaction

# Bulk annotation endpoints, used by the evaluation harness. Off in a deployment.
ROVER_BULK_ANNOTATION=false

# ---------------------------------------------------------------- deploying
# infra/deploy.sh reads these; they are not read by the application. The script passes
# them to the Bicep template, which derives the issuer and the redirect URI above from the
# environment it creates, so those three do not have to be supplied twice.
#
#   RESOURCE_GROUP   defaults to rover-notes
#   LOCATION         defaults to eastus
#   NAME_PREFIX      defaults to rovernotes; becomes <name-prefix> above
#   TAG              defaults to the current commit
#
# Required by the script: POSTGRES_PASSWORD, ANTHROPIC_API_KEY, ROVER_KEY_ENCRYPTION_KEY
# and MAIL_HOST. Optional alongside MAIL_HOST: MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD,
# MAIL_FROM. See infra/README.md.
