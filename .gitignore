# secrets
.env
.env.local
*.pem
*.key

# jvm
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
*.class
*.log

# python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
uv.lock

# node
node_modules/
.next/
# Generated by `next dev` and `next build`, which rewrite the paths inside it when the
# build output moves — tracked, it shows up as a modification after the documented dev
# command. `tsc --noEmit` passes without it: the Next types tsconfig needs come from its
# `.next/dev/types/**` include and from normal module resolution, checked on a clone with
# neither the file nor a build directory present.
web/next-env.d.ts
out/
dist/
*.tsbuildinfo

# eval artifacts — results are committed, raw dumps are not
evals/runs/
evals/**/*.raw.json

# editors / os
.idea/
.vscode/
.DS_Store

# eval fixtures downloaded on demand, not redistributed here
evals/.cache/
evals/corpus-scifact/
evals/golden-scifact/

# playwright output
test-results/
web/test-results/
web/playwright-report/
web/blob-report/
